<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ReceiptVault.Views.ReceiptDetailPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ReceiptVault.ViewModels"
    xmlns:conv="clr-namespace:ReceiptVault.Converters"
    xmlns:models="clr-namespace:ReceiptVault.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource AppBackground}">

    <ContentPage.Resources>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Top nav -->
        <Grid Grid.Row="0" Padding="24,60,24,16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Button Grid.Column="0"
                    Text="←"
                    FontSize="20"
                    TextColor="{StaticResource AppTextSecondary}"
                    BackgroundColor="{StaticResource AppSurface}"
                    CornerRadius="12"
                    WidthRequest="44" HeightRequest="44"
                    Padding="0"
                    Clicked="OnBackClicked"/>
            <Label Grid.Column="1"
                   Text="{Binding Merchant}"
                   FontSize="18" FontAttributes="Bold"
                   TextColor="{StaticResource AppTextPrimary}"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation"/>
            <Button Grid.Column="2"
                    Text="{Binding IsEditing, Converter={StaticResource EditButtonConverter}}"
                    FontSize="14"
                    TextColor="{StaticResource AppIndigo}"
                    BackgroundColor="{StaticResource AppSurface}"
                    CornerRadius="12"
                    Padding="12,0"
                    HeightRequest="44"
                    Command="{Binding ToggleEditCommand}"/>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,0,24,24" Spacing="16">

                <!-- Receipt image -->
                <Border IsVisible="{Binding Receipt.ImagePath, Converter={StaticResource StringNotNullConverter}}"
                        HeightRequest="200"
                        BackgroundColor="{StaticResource AppSurface}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">
                    <Image Source="{Binding Receipt.ImagePath}" Aspect="AspectFill"/>
                </Border>

                <!-- Summary card -->
                <Border BackgroundColor="{StaticResource AppSurface}"
                        StrokeThickness="1" Stroke="{StaticResource AppBorder}"
                        StrokeShape="RoundRectangle 16" Padding="20">
                    <Grid RowDefinitions="Auto,1,Auto" RowSpacing="16">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Total"
                                   FontSize="14" TextColor="{StaticResource AppTextSecondary}"/>
                            <Label Grid.Column="1"
                                   Text="{Binding Receipt.FormattedTotal}"
                                   FontSize="28" FontAttributes="Bold"
                                   TextColor="{StaticResource AppTextPrimary}"/>
                        </Grid>
                        <BoxView Grid.Row="1" HeightRequest="1" Color="{StaticResource AppBorder}"/>
                        <Grid Grid.Row="2" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Grid.Row="0" Spacing="2">
                                <Label Text="Date" FontSize="12" TextColor="{StaticResource AppTextSecondary}"/>
                                <Label Text="{Binding Date, StringFormat='{0:d MMM yyyy}'}"
                                       FontSize="14" TextColor="{StaticResource AppTextPrimary}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Grid.Row="0" Spacing="2">
                                <Label Text="Category" FontSize="12" TextColor="{StaticResource AppTextSecondary}"/>
                                <Label Text="{Binding SelectedCategory}"
                                       FontSize="14" TextColor="{StaticResource AppTextPrimary}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="0" Grid.Row="1" Spacing="2">
                                <Label Text="Type" FontSize="12" TextColor="{StaticResource AppTextSecondary}"/>
                                <Label Text="{Binding IsBusinessExpense, Converter={StaticResource ExpenseTypeConverter}}"
                                       FontSize="14" TextColor="{StaticResource AppTextPrimary}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Items (read-only) -->
                <Border BackgroundColor="{StaticResource AppSurface}"
                        StrokeThickness="1" Stroke="{StaticResource AppBorder}"
                        StrokeShape="RoundRectangle 16" Padding="20">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsEditing}" Value="True">
                            <Setter Property="IsVisible" Value="False"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding HasLineItems}" Value="False">
                            <Setter Property="IsVisible" Value="False"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsPremium}" Value="False">
                            <Setter Property="IsVisible" Value="False"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Items" FontSize="13" TextColor="{StaticResource AppTextSecondary}"/>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding LineItems}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:LineItem">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label FontSize="15" TextColor="{StaticResource AppTextPrimary}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding QuantityPrefix}"
                                                              TextColor="{StaticResource AppTextSecondary}"/>
                                                        <Span Text="{Binding Description}"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label Text="{Binding FormattedSavings}"
                                                   IsVisible="{Binding HasSavings}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource AppMint}"/>
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1"
                                               Text="{Binding FormattedPrice}"
                                               FontSize="15"
                                               TextColor="{StaticResource AppTextPrimary}"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Locked items card for free users (view mode) -->
                <Border BackgroundColor="{StaticResource AppSurface}"
                        IsVisible="{Binding ShowLockedItems}"
                        StrokeThickness="1" Stroke="{StaticResource AppBorder}"
                        StrokeShape="RoundRectangle 16" Padding="20">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsEditing}" Value="True">
                            <Setter Property="IsVisible" Value="False"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Items" FontSize="13"
                                   TextColor="{StaticResource AppTextSecondary}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="🔒 Premium" FontSize="12"
                                   TextColor="{StaticResource AppMint}"
                                   VerticalOptions="Center"/>
                        </Grid>
                        <Label Text="{Binding LineItemCount, StringFormat='{0} items scanned from this receipt. Unlock Premium to view and edit the itemised breakdown.'}"
                               FontSize="13" TextColor="{StaticResource AppTextSecondary}"/>
                        <VerticalStackLayout Spacing="6">
                            <BoxView HeightRequest="12" WidthRequest="200" HorizontalOptions="Start"
                                     Color="{StaticResource AppSurfaceVariant}" CornerRadius="6"/>
                            <BoxView HeightRequest="12" WidthRequest="150" HorizontalOptions="Start"
                                     Color="{StaticResource AppSurfaceVariant}" CornerRadius="6"/>
                            <BoxView HeightRequest="12" WidthRequest="180" HorizontalOptions="Start"
                                     Color="{StaticResource AppSurfaceVariant}" CornerRadius="6"/>
                        </VerticalStackLayout>
                        <Button Text="Unlock Premium"
                                BackgroundColor="{StaticResource AppIndigo}"
                                TextColor="White" FontAttributes="Bold"
                                CornerRadius="10" HeightRequest="44"
                                Command="{Binding UnlockCommand}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Edit form (visible when editing) -->
                <VerticalStackLayout IsVisible="{Binding IsEditing}" Spacing="12">

                    <Label Text="Merchant" FontSize="13" TextColor="{StaticResource AppTextSecondary}"/>
                    <Border BackgroundColor="{StaticResource AppSurface}"
                            StrokeThickness="1" Stroke="{StaticResource AppBorder}"
                            StrokeShape="RoundRectangle 12" Padding="4,0">
                        <Entry Text="{Binding Merchant}"
                               TextColor="{StaticResource AppTextPrimary}"
                               PlaceholderColor="{StaticResource AppTextMuted}"/>
                    </Border>

                    <Label Text="Total (£)" FontSize="13" TextColor="{StaticResource AppTextSecondary}"/>
                    <Border BackgroundColor="{StaticResource AppSurface}"
                            StrokeThickness="1" Stroke="{StaticResource AppBorder}"
                            StrokeShape="RoundRectangle 12" Padding="4,0">
                        <Entry Text="{Binding TotalText}" Keyboard="Numeric"
                               TextColor="{StaticResource AppTextPrimary}"/>
                    </Border>

                    <Label Text="Date" FontSize="13" TextColor="{StaticResource AppTextSecondary}"/>
                    <Border BackgroundColor="{StaticResource AppSurface}"
                            StrokeThickness="1" Stroke="{StaticResource AppBorder}"
                            StrokeShape="RoundRectangle 12" Padding="16,0">
                        <DatePicker Date="{Binding Date}"
                                    TextColor="{StaticResource AppTextPrimary}"
                                    Format="d MMM yyyy"/>
                    </Border>

                    <Label Text="Category" FontSize="13" TextColor="{StaticResource AppTextSecondary}"/>
                    <Border BackgroundColor="{StaticResource AppSurface}"
                            StrokeThickness="1" Stroke="{StaticResource AppBorder}"
                            StrokeShape="RoundRectangle 12" Padding="16,0">
                        <Picker ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding SelectedCategory}"
                                TextColor="{StaticResource AppTextPrimary}"/>
                    </Border>

                    <Border BackgroundColor="{StaticResource AppSurface}"
                            StrokeThickness="1" Stroke="{StaticResource AppBorder}"
                            StrokeShape="RoundRectangle 14" Padding="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Business expense"
                                   FontSize="15" TextColor="{StaticResource AppTextPrimary}"
                                   VerticalOptions="Center"/>
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding IsBusinessExpense}"
                                    OnColor="{StaticResource AppIndigo}"/>
                        </Grid>
                    </Border>

                    <Label Text="Notes" FontSize="13" TextColor="{StaticResource AppTextSecondary}"/>
                    <Border BackgroundColor="{StaticResource AppSurface}"
                            StrokeThickness="1" Stroke="{StaticResource AppBorder}"
                            StrokeShape="RoundRectangle 12" Padding="4,0">
                        <Editor Text="{Binding Notes}"
                                Placeholder="Add notes…"
                                AutoSize="TextChanges"
                                PlaceholderColor="{StaticResource AppTextMuted}"
                                TextColor="{StaticResource AppTextPrimary}"
                                MinimumHeightRequest="60"/>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0"
                          IsVisible="{Binding IsPremium}">
                        <Label Grid.Column="0" Text="Items" FontSize="13"
                               TextColor="{StaticResource AppTextSecondary}"
                               VerticalOptions="Center"/>
                        <Button Grid.Column="1"
                                Text="＋ Add item"
                                FontSize="13"
                                Padding="12,0"
                                HeightRequest="36"
                                BackgroundColor="{StaticResource AppSurfaceVariant}"
                                TextColor="{StaticResource AppMint}"
                                CornerRadius="10"
                                Command="{Binding AddLineItemCommand}"/>
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding LineItems}" Spacing="8"
                                         IsVisible="{Binding IsPremium}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:LineItem">
                                <Border BackgroundColor="{StaticResource AppSurface}"
                                        StrokeThickness="1" Stroke="{StaticResource AppBorder}"
                                        StrokeShape="RoundRectangle 12" Padding="12">
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Entry Grid.Column="0"
                                                   Text="{Binding Description}"
                                                   Placeholder="Item description"
                                                   TextColor="{StaticResource AppTextPrimary}"
                                                   PlaceholderColor="{StaticResource AppTextMuted}"/>
                                            <Button Grid.Column="1"
                                                    Text="✕"
                                                    FontSize="14"
                                                    WidthRequest="36" HeightRequest="36"
                                                    Padding="0"
                                                    BackgroundColor="{StaticResource AppSurfaceVariant}"
                                                    TextColor="{StaticResource AppError}"
                                                    CornerRadius="10"
                                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.RemoveLineItemCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="Qty" FontSize="11" TextColor="{StaticResource AppTextMuted}"/>
                                                <Entry Text="{Binding Quantity}" Keyboard="Numeric"
                                                       TextColor="{StaticResource AppTextPrimary}"/>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="Price" FontSize="11" TextColor="{StaticResource AppTextMuted}"/>
                                                <Entry Text="{Binding Price}" Keyboard="Numeric"
                                                       TextColor="{StaticResource AppTextPrimary}"/>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                                <Label Text="Saving" FontSize="11" TextColor="{StaticResource AppTextMuted}"/>
                                                <Entry Text="{Binding Savings}" Keyboard="Numeric"
                                                       TextColor="{StaticResource AppTextPrimary}"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Bottom add-item button: appends to the end of the list -->
                    <Button Text="＋ Add item"
                            IsVisible="{Binding ShowBottomAddItem}"
                            FontSize="13"
                            HeightRequest="40"
                            BackgroundColor="{StaticResource AppSurfaceVariant}"
                            TextColor="{StaticResource AppMint}"
                            CornerRadius="10"
                            Command="{Binding AddLineItemBottomCommand}"/>

                    <!-- Locked items card for free users (edit mode) -->
                    <Border IsVisible="{Binding ShowLockedItems}"
                            BackgroundColor="{StaticResource AppSurface}"
                            StrokeThickness="1" Stroke="{StaticResource AppBorder}"
                            StrokeShape="RoundRectangle 12" Padding="16">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Items" FontSize="13"
                                       TextColor="{StaticResource AppTextSecondary}"
                                       VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="🔒 Premium" FontSize="12"
                                       TextColor="{StaticResource AppMint}"
                                       VerticalOptions="Center"/>
                            </Grid>
                            <Label Text="{Binding LineItemCount, StringFormat='{0} items scanned from this receipt. Unlock Premium to view and edit the itemised breakdown.'}"
                                   FontSize="13" TextColor="{StaticResource AppTextSecondary}"/>
                            <Button Text="Unlock Premium"
                                    BackgroundColor="{StaticResource AppIndigo}"
                                    TextColor="White" FontAttributes="Bold"
                                    CornerRadius="10" HeightRequest="44"
                                    Command="{Binding UnlockCommand}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Button Text="Save changes"
                            BackgroundColor="{StaticResource AppIndigo}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            HeightRequest="52"
                            Command="{Binding SaveCommand}"/>
                </VerticalStackLayout>

                <!-- Notes display (read-only) -->
                <Border IsVisible="{Binding IsEditing, Converter={StaticResource InverseBool}}"
                        BackgroundColor="{StaticResource AppSurface}"
                        StrokeThickness="1" Stroke="{StaticResource AppBorder}"
                        StrokeShape="RoundRectangle 16" Padding="20">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Notes" FontSize="13" TextColor="{StaticResource AppTextSecondary}"/>
                        <Label Text="{Binding Notes}"
                               FontSize="14"
                               TextColor="{StaticResource AppTextPrimary}"/>
                        <Label IsVisible="{Binding Notes, Converter={StaticResource StringNullConverter}}"
                               Text="No notes"
                               FontSize="14"
                               TextColor="{StaticResource AppTextMuted}"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom actions -->
        <Grid Grid.Row="2" Padding="24,12,24,40"
              ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <Button Grid.Column="0"
                    Text="Share / Export"
                    BackgroundColor="{StaticResource AppSurface}"
                    TextColor="{StaticResource AppTextPrimary}"
                    CornerRadius="14"
                    HeightRequest="52"
                    Command="{Binding ShareReceiptCommand}"/>
            <Button Grid.Column="1"
                    Text="🗑"
                    FontSize="18"
                    BackgroundColor="{StaticResource AppSurface}"
                    TextColor="{StaticResource AppError}"
                    CornerRadius="14"
                    WidthRequest="52" HeightRequest="52"
                    Padding="0"
                    Command="{Binding DeleteCommand}"/>
        </Grid>

    </Grid>
</ContentPage>
