<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ReceiptVault.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource AppBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <BoxView HeightRequest="52" Color="Transparent"/>

            <Label Text="Settings"
                   FontSize="28" FontAttributes="Bold"
                   TextColor="{StaticResource AppTextPrimary}"/>

            <!-- Subscription card -->
            <Border BackgroundColor="{StaticResource AppIndigo}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Receipt Vault Premium"
                                   FontSize="16" FontAttributes="Bold"
                                   TextColor="White"/>
                            <Label Text="{Binding SubscriptionLabel}"
                                   FontSize="13"
                                   TextColor="#CCCCFF"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="⭐"
                               FontSize="32"
                               VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#33FFFFFF" Margin="0,4"/>
                    <Label Text="WHAT'S INCLUDED"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="#CCCCFF"/>

                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="☁️" FontSize="18" VerticalOptions="Start"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="iCloud backup &amp; sync"
                                       FontSize="14" FontAttributes="Bold" TextColor="White"/>
                                <Label Text="Your receipts are backed up to your own iCloud and kept in sync across your devices. Lose or replace your phone and every receipt is still there — just sign in."
                                       FontSize="12" TextColor="#CCCCFF"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="🔎" FontSize="18" VerticalOptions="Start"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Automatic item scanning"
                                       FontSize="14" FontAttributes="Bold" TextColor="White"/>
                                <Label Text="Capture every item, price and saving on a receipt — not just the total."
                                       FontSize="12" TextColor="#CCCCFF"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="📄" FontSize="18" VerticalOptions="Start"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="PDF &amp; itemised export"
                                       FontSize="14" FontAttributes="Bold" TextColor="White"/>
                                <Label Text="Export polished PDFs and full itemised spreadsheets. Basic CSV stays free."
                                       FontSize="12" TextColor="#CCCCFF"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="📊" FontSize="18" VerticalOptions="Start"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Tax &amp; expense reports"
                                       FontSize="14" FontAttributes="Bold" TextColor="White"/>
                                <Label Text="Business-expense and tax summaries, ready for your accountant."
                                       FontSize="12" TextColor="#CCCCFF"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#33FFFFFF" Margin="0,4"/>

                    <Button IsVisible="{Binding IsPremium, Converter={StaticResource InverseBool}}"
                            Text="Unlock Premium"
                            BackgroundColor="White"
                            TextColor="{StaticResource AppIndigo}"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="48"
                            Command="{Binding UpgradeCommand}"/>
                    <Button IsVisible="{Binding IsPremium, Converter={StaticResource InverseBool}}"
                            Text="Restore purchases"
                            BackgroundColor="Transparent"
                            TextColor="#CCCCFF"
                            FontSize="13"
                            HeightRequest="36"
                            Command="{Binding RestorePurchasesCommand}"/>
                </VerticalStackLayout>
            </Border>

            <!-- Debug-only: reset entitlement for sandbox purchase testing -->
            <Button IsVisible="{Binding IsDebugBuild}"
                    Text="Reset to Free (debug)"
                    BackgroundColor="{StaticResource AppSurfaceVariant}"
                    TextColor="{StaticResource AppError}"
                    FontSize="13"
                    CornerRadius="12"
                    HeightRequest="44"
                    Command="{Binding ResetEntitlementCommand}"/>

            <!-- Export section -->
            <Label Text="Export"
                   FontSize="13" FontAttributes="Bold"
                   TextColor="{StaticResource AppTextSecondary}"
                   Margin="0,4,0,-8"/>

            <Border BackgroundColor="{StaticResource AppSurface}"
                    StrokeThickness="1" Stroke="{StaticResource AppBorder}"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout>
                    <Button Text="Export this month to CSV"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource AppTextPrimary}"
                            HorizontalOptions="Fill"
                            HeightRequest="52"
                            Command="{Binding ExportMonthCommand}"/>
                    <BoxView HeightRequest="1" Color="{StaticResource AppBorder}" Margin="16,0"/>
                    <Button Text="Export all receipts to CSV"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource AppTextPrimary}"
                            HorizontalOptions="Fill"
                            HeightRequest="52"
                            Command="{Binding ExportAllCommand}"/>
                </VerticalStackLayout>
            </Border>

            <!-- Preferences -->
            <Label Text="Preferences"
                   FontSize="13" FontAttributes="Bold"
                   TextColor="{StaticResource AppTextSecondary}"
                   Margin="0,4,0,-8"/>

            <Border BackgroundColor="{StaticResource AppSurface}"
                    StrokeThickness="1" Stroke="{StaticResource AppBorder}"
                    StrokeShape="RoundRectangle 16" Padding="16">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label Grid.Column="0"
                           Text="Default currency"
                           FontSize="15"
                           TextColor="{StaticResource AppTextPrimary}"
                           VerticalOptions="Center"/>
                    <Picker Grid.Column="1"
                            ItemsSource="{Binding Currencies}"
                            SelectedItem="{Binding SelectedCurrency}"
                            TextColor="{StaticResource AppTextPrimary}"
                            WidthRequest="90"
                            HorizontalOptions="End"/>
                </Grid>
            </Border>

            <!-- About -->
            <Label Text="About"
                   FontSize="13" FontAttributes="Bold"
                   TextColor="{StaticResource AppTextSecondary}"
                   Margin="0,4,0,-8"/>

            <Border BackgroundColor="{StaticResource AppSurface}"
                    StrokeThickness="1" Stroke="{StaticResource AppBorder}"
                    StrokeShape="RoundRectangle 16" Padding="20">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Receipt Vault"
                               FontSize="15" TextColor="{StaticResource AppTextPrimary}"/>
                        <Label Grid.Column="1" Text="v1.0"
                               FontSize="14" TextColor="{StaticResource AppTextSecondary}"/>
                    </Grid>
                    <Label Text="Snap, tag and export your receipts. No account required."
                           FontSize="13"
                           TextColor="{StaticResource AppTextSecondary}"/>
                </VerticalStackLayout>
            </Border>

            <BoxView HeightRequest="40" Color="Transparent"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
