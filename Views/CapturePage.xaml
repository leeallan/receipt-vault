<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ReceiptVault.Views.CapturePage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ReceiptVault.ViewModels"
    xmlns:models="clr-namespace:ReceiptVault.Models"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource AppBackground}">

    <ContentPage.Resources>
        <Style TargetType="Entry">
            <Setter Property="BackgroundColor" Value="{StaticResource AppSurface}"/>
            <Setter Property="TextColor" Value="{StaticResource AppTextPrimary}"/>
            <Setter Property="PlaceholderColor" Value="{StaticResource AppTextMuted}"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <BoxView HeightRequest="52" Color="Transparent"/>

            <!-- Title row -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="✕"
                        FontSize="18"
                        TextColor="{StaticResource AppTextSecondary}"
                        BackgroundColor="{StaticResource AppSurface}"
                        CornerRadius="12"
                        WidthRequest="44" HeightRequest="44"
                        Padding="0"
                        Command="{Binding CancelCommand}"/>
                <Label Grid.Column="1"
                       Text="New Receipt"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource AppTextPrimary}"
                       VerticalOptions="Center"/>
            </Grid>

            <!-- Image capture area -->
            <Border HeightRequest="200"
                    BackgroundColor="{StaticResource AppSurface}"
                    StrokeThickness="1"
                    Stroke="{StaticResource AppBorder}"
                    StrokeShape="RoundRectangle 20">
                <Grid>
                    <!-- No image placeholder -->
                    <VerticalStackLayout IsVisible="{Binding HasImage, Converter={StaticResource InverseBool}}"
                                        VerticalOptions="Center"
                                        HorizontalOptions="Center"
                                        Spacing="12">
                        <Label Text="📷" FontSize="48" HorizontalOptions="Center"/>
                        <Label Text="Add a photo of your receipt"
                               FontSize="14"
                               TextColor="{StaticResource AppTextSecondary}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- Captured image -->
                    <Image IsVisible="{Binding HasImage}"
                           Source="{Binding CapturedImagePath}"
                           Aspect="AspectFill"/>

                    <!-- OCR processing overlay -->
                    <Border IsVisible="{Binding IsProcessingOcr}"
                            BackgroundColor="#CC0D0D1A"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 20">
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                            <ActivityIndicator IsRunning="True" Color="{StaticResource AppMint}" WidthRequest="36" HeightRequest="36"/>
                            <Label Text="Reading receipt…"
                                   FontSize="14"
                                   TextColor="{StaticResource AppTextPrimary}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Border>

            <!-- Camera / Gallery buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="📷  Camera"
                        BackgroundColor="{StaticResource AppSurfaceVariant}"
                        TextColor="{StaticResource AppTextPrimary}"
                        CornerRadius="14"
                        HeightRequest="48"
                        Command="{Binding TakePhotoCommand}"/>
                <Button Grid.Column="1"
                        Text="🖼  Gallery"
                        BackgroundColor="{StaticResource AppSurfaceVariant}"
                        TextColor="{StaticResource AppTextPrimary}"
                        CornerRadius="14"
                        HeightRequest="48"
                        Command="{Binding PickPhotoCommand}"/>
            </Grid>

            <!-- Divider -->
            <BoxView HeightRequest="1" Color="{StaticResource AppBorder}" Margin="0,8"/>

            <!-- Form fields -->
            <Label Text="Merchant" FontSize="13" TextColor="{StaticResource AppTextSecondary}"/>
            <Border BackgroundColor="{StaticResource AppSurface}"
                    StrokeThickness="1" Stroke="{StaticResource AppBorder}"
                    StrokeShape="RoundRectangle 12" Padding="4,0">
                <Entry Text="{Binding Merchant}"
                       Placeholder="e.g. Tesco, Costa Coffee"
                       ReturnType="Next"/>
            </Border>

            <Label Text="Total (£)" FontSize="13" TextColor="{StaticResource AppTextSecondary}"/>
            <Border BackgroundColor="{StaticResource AppSurface}"
                    StrokeThickness="1" Stroke="{StaticResource AppBorder}"
                    StrokeShape="RoundRectangle 12" Padding="4,0">
                <Entry Text="{Binding TotalText}"
                       Placeholder="0.00"
                       Keyboard="Numeric"
                       ReturnType="Next"/>
            </Border>

            <!-- Line items -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                <Label Grid.Column="0" Text="Items" FontSize="13"
                       TextColor="{StaticResource AppTextSecondary}"
                       VerticalOptions="Center"/>
                <Button Grid.Column="1"
                        Text="＋ Add item"
                        FontSize="13"
                        Padding="12,0"
                        HeightRequest="36"
                        BackgroundColor="{StaticResource AppSurfaceVariant}"
                        TextColor="{StaticResource AppMint}"
                        CornerRadius="10"
                        Command="{Binding AddLineItemCommand}"/>
            </Grid>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding LineItems}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:LineItem">
                        <Border BackgroundColor="{StaticResource AppSurface}"
                                StrokeThickness="1" Stroke="{StaticResource AppBorder}"
                                StrokeShape="RoundRectangle 12" Padding="12">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Entry Grid.Column="0"
                                           Text="{Binding Description}"
                                           Placeholder="Item description"
                                           BackgroundColor="Transparent"/>
                                    <Button Grid.Column="1"
                                            Text="✕"
                                            FontSize="14"
                                            WidthRequest="36" HeightRequest="36"
                                            Padding="0"
                                            BackgroundColor="{StaticResource AppSurfaceVariant}"
                                            TextColor="{StaticResource AppError}"
                                            CornerRadius="10"
                                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.RemoveLineItemCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="Qty" FontSize="11" TextColor="{StaticResource AppTextMuted}"/>
                                        <Entry Text="{Binding Quantity}" Keyboard="Numeric"
                                               BackgroundColor="Transparent"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Price" FontSize="11" TextColor="{StaticResource AppTextMuted}"/>
                                        <Entry Text="{Binding Price}" Keyboard="Numeric"
                                               BackgroundColor="Transparent"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="2">
                                        <Label Text="Saving" FontSize="11" TextColor="{StaticResource AppTextMuted}"/>
                                        <Entry Text="{Binding Savings}" Keyboard="Numeric"
                                               BackgroundColor="Transparent"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="Date" FontSize="13" TextColor="{StaticResource AppTextSecondary}"/>
            <Border BackgroundColor="{StaticResource AppSurface}"
                    StrokeThickness="1" Stroke="{StaticResource AppBorder}"
                    StrokeShape="RoundRectangle 12" Padding="16,0">
                <DatePicker Date="{Binding Date}"
                            TextColor="{StaticResource AppTextPrimary}"
                            Format="d MMM yyyy"/>
            </Border>

            <Label Text="Category" FontSize="13" TextColor="{StaticResource AppTextSecondary}"/>
            <Border BackgroundColor="{StaticResource AppSurface}"
                    StrokeThickness="1" Stroke="{StaticResource AppBorder}"
                    StrokeShape="RoundRectangle 12" Padding="16,0">
                <Picker ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory}"
                        TextColor="{StaticResource AppTextPrimary}"
                        TitleColor="{StaticResource AppTextMuted}"/>
            </Border>

            <!-- Business toggle -->
            <Border BackgroundColor="{StaticResource AppSurface}"
                    StrokeThickness="1" Stroke="{StaticResource AppBorder}"
                    StrokeShape="RoundRectangle 14" Padding="16">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Business expense"
                               FontSize="15"
                               TextColor="{StaticResource AppTextPrimary}"/>
                        <Label Text="Mark for expense reporting"
                               FontSize="12"
                               TextColor="{StaticResource AppTextSecondary}"/>
                    </VerticalStackLayout>
                    <Switch Grid.Column="1"
                            IsToggled="{Binding IsBusinessExpense}"
                            OnColor="{StaticResource AppIndigo}"
                            VerticalOptions="Center"/>
                </Grid>
            </Border>

            <Label Text="Notes (optional)" FontSize="13" TextColor="{StaticResource AppTextSecondary}"/>
            <Border BackgroundColor="{StaticResource AppSurface}"
                    StrokeThickness="1" Stroke="{StaticResource AppBorder}"
                    StrokeShape="RoundRectangle 12" Padding="4,0">
                <Editor Text="{Binding Notes}"
                        Placeholder="Add any notes…"
                        AutoSize="TextChanges"
                        PlaceholderColor="{StaticResource AppTextMuted}"
                        TextColor="{StaticResource AppTextPrimary}"
                        MinimumHeightRequest="60"/>
            </Border>

            <!-- Save button -->
            <Button Text="Save Receipt"
                    BackgroundColor="{StaticResource AppIndigo}"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="16"
                    HeightRequest="56"
                    Command="{Binding SaveCommand}"
                    Margin="0,8,0,40"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
