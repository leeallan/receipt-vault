<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>ReceiptVault.Server</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Data.Tables" Version="12.9.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Shared\ReceiptVault.Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Public Apple Root CA — G3 (not a secret); used to validate transaction JWS chains. -->
		<Content Include="AppleRootCA-G3.cer" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
