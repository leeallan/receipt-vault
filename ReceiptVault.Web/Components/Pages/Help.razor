@page "/help"

<PageTitle>Help Guide — Receipt Vault</PageTitle>

<HeadContent>
    <meta name="description" content="How to use Receipt Vault — scanning receipts, capturing line items, organising and searching, exporting, and getting the most from Premium and cloud backup." />
    <link rel="canonical" href="https://receiptvault.farabove.uk/help" />
    <meta property="og:title" content="Help Guide — Receipt Vault" />
    <meta property="og:description" content="Scan receipts, capture line items, organise, search and export — the complete guide." />
    <meta property="og:url" content="https://receiptvault.farabove.uk/help" />

    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "FAQPage",
      "mainEntity": [
        { "@@type": "Question", "name": "Do I need an account to use Receipt Vault?", "acceptedAnswer": { "@@type": "Answer", "text": "No. You can scan and organise receipts with no account or sign-up. An App Store purchase is only needed for Premium features." } },
        { "@@type": "Question", "name": "Are my receipts uploaded to the cloud?", "acceptedAnswer": { "@@type": "Answer", "text": "No — receipts and images are stored on your device, and text recognition runs on-device. Cloud backup only applies if you subscribe to a plan that includes Cloud Backup & Sync." } },
        { "@@type": "Question", "name": "How much does Receipt Vault cost?", "acceptedAnswer": { "@@type": "Answer", "text": "Scanning and organising are free. Premium is £2.99/month or £19.99/year and adds item scanning, PDF and tax reports, and cloud backup & sync. A one-time Lifetime unlock is £39.99 and includes all on-device premium features (cloud sync is on the subscription plans)." } },
        { "@@type": "Question", "name": "Does cloud sync come with the Lifetime plan?", "acceptedAnswer": { "@@type": "Answer", "text": "No. Lifetime unlocks every on-device premium feature permanently, but cloud backup & sync is available on the monthly and annual subscriptions, because it is an ongoing service." } }
      ]
    }
    </script>
</HeadContent>

<div class="page-hero" style="padding-bottom:40px;">
    <div class="page-hero-content">
        <span class="section-label">User Guide</span>
        <h1>Receipt Vault Help</h1>
        <p>Everything you need to scan, organise and export your receipts</p>
        <div style="display:flex; gap:10px; justify-content:center; margin-top:16px; flex-wrap:wrap;">
            <span style="background:rgba(108,99,255,0.15);border:1px solid rgba(108,99,255,0.3);border-radius:20px;padding:5px 14px;font-size:0.8rem;font-weight:500;color:var(--primary-light);">📸 On-device scanning</span>
            <span style="background:rgba(108,99,255,0.15);border:1px solid rgba(108,99,255,0.3);border-radius:20px;padding:5px 14px;font-size:0.8rem;font-weight:500;color:var(--primary-light);">🧾 Line items</span>
            <span style="background:rgba(108,99,255,0.15);border:1px solid rgba(108,99,255,0.3);border-radius:20px;padding:5px 14px;font-size:0.8rem;font-weight:500;color:var(--primary-light);">🔒 Private by default</span>
        </div>
    </div>
</div>

<div class="help-layout">

    <!-- TOC -->
    <nav class="help-toc">
        <h3>Contents</h3>
        <a href="/help#overview"><span>🏠</span> Overview</a>
        <a href="/help#getting-started"><span>🚀</span> Getting Started</a>
        <hr />
        <a href="/help#scanning"><span>📸</span> Scanning a Receipt</a>
        <a href="/help#line-items"><span>🧾</span> Line Items</a>
        <a href="/help#organising"><span>🏷️</span> Organising</a>
        <a href="/help#export"><span>📤</span> Export</a>
        <hr />
        <a href="/help#premium"><span>⭐</span> Premium &amp; Sync</a>
        <a href="/help#tips"><span>💡</span> Tips</a>
        <a href="/help#faq"><span>❓</span> FAQ</a>
    </nav>

    <!-- MAIN -->
    <div class="help-main">

        <section class="help-section" id="overview">
            <div class="help-section-header">
                <div class="help-section-icon icon-purple">🏠</div>
                <h2>What is Receipt Vault?</h2>
            </div>
            <div class="help-highlight">
                <p>Receipt Vault turns the pile of paper receipts in your pocket, bag and glovebox into a tidy, searchable record. Photograph a receipt and it <strong>reads the merchant, total and date for you</strong>, captures the <strong>individual items</strong> you bought, and files it — all on your device, no account required.</p>
            </div>
            <div class="help-card">
                <h3>What you can do</h3>
                <div class="help-feature-list">
                    <div class="help-feature"><div class="help-feature-check">✓</div> Scan unlimited receipts with on-device text recognition</div>
                    <div class="help-feature"><div class="help-feature-check">✓</div> Auto-capture the merchant, total and date</div>
                    <div class="help-feature"><div class="help-feature-check">✓</div> Capture each line item — description, quantity, price and savings</div>
                    <div class="help-feature"><div class="help-feature-check">✓</div> Categorise and tag receipts as business or personal</div>
                    <div class="help-feature"><div class="help-feature-check">✓</div> Search across every receipt in a tap</div>
                    <div class="help-feature"><div class="help-feature-check">✓</div> Export to CSV — free — or PDF and itemised spreadsheets with Premium</div>
                    <div class="help-feature"><div class="help-feature-check">✓</div> Keep everything private on your device, with optional cloud backup</div>
                </div>
            </div>
        </section>

        <section class="help-section" id="getting-started">
            <div class="help-section-header">
                <div class="help-section-icon icon-green">🚀</div>
                <h2>Getting started</h2>
            </div>
            <p>There's nothing to set up — open the app and start scanning. No account, no sign-up.</p>
            <div class="help-steps">
                <div class="help-step">
                    <div class="help-step-num">1</div>
                    <div class="help-step-body"><h4>Open the app</h4><p>Receipt Vault opens on your dashboard. Tap the capture button to add your first receipt.</p></div>
                </div>
                <div class="help-step">
                    <div class="help-step-num">2</div>
                    <div class="help-step-body"><h4>Allow the camera</h4><p>Grant camera access the first time so you can photograph receipts. You can also pick existing photos from your library.</p></div>
                </div>
                <div class="help-step">
                    <div class="help-step-num">3</div>
                    <div class="help-step-body"><h4>Scan and save</h4><p>That's it — capture, check the details, and save. Your receipt is filed and searchable.</p></div>
                </div>
            </div>
        </section>

        <section class="help-section" id="scanning">
            <div class="help-section-header">
                <div class="help-section-icon icon-pink">📸</div>
                <h2>Scanning a receipt</h2>
            </div>
            <div class="help-steps">
                <div class="help-step">
                    <div class="help-step-num">1</div>
                    <div class="help-step-body"><h4>Take a photo (or pick one)</h4><p>Tap <strong>Camera</strong> to photograph the receipt, or <strong>Gallery</strong> to choose one you already have.</p></div>
                </div>
                <div class="help-step">
                    <div class="help-step-num">2</div>
                    <div class="help-step-body"><h4>Let it read</h4><p>Receipt Vault recognises the text on-device and fills in the merchant, total and date automatically.</p></div>
                </div>
                <div class="help-step">
                    <div class="help-step-num">3</div>
                    <div class="help-step-body"><h4>Check and adjust</h4><p>Scanning is very good but not perfect — glance over the details and correct anything before saving.</p></div>
                </div>
            </div>
            <div class="help-tip">
                <p>💡 <strong>Best results:</strong> lay the receipt flat on a contrasting surface in good light, and include the whole receipt in the frame. Long receipts scan well even with multiple columns.</p>
            </div>
        </section>

        <section class="help-section" id="line-items">
            <div class="help-section-header">
                <div class="help-section-icon icon-green">🧾</div>
                <h2>Line items</h2>
            </div>
            <p>With Premium, Receipt Vault captures <strong>each item</strong> on the receipt, not just the total — the description, quantity, unit price and any savings — and reassembles even tricky multi-column supermarket layouts into a clean list.</p>
            <div class="help-feature-list">
                <div class="help-feature"><div class="help-feature-check">✓</div> Items appear under the receipt, ready to review</div>
                <div class="help-feature"><div class="help-feature-check">✓</div> Edit any item's description, quantity, price or saving</div>
                <div class="help-feature"><div class="help-feature-check">✓</div> Add or remove items by hand where needed</div>
            </div>
            <div class="help-tip">
                <p>💡 Item scanning is a Premium feature. Receipts vary hugely, so always give the captured items a quick check — the list is fully editable.</p>
            </div>
        </section>

        <section class="help-section" id="organising">
            <div class="help-section-header">
                <div class="help-section-icon icon-purple">🏷️</div>
                <h2>Organising &amp; searching</h2>
            </div>
            <p>Keep receipts findable with categories, tags, notes, and a business/personal flag for expense reporting.</p>
            <div class="help-feature-list">
                <div class="help-feature"><div class="help-feature-check">✓</div> Assign a category to each receipt</div>
                <div class="help-feature"><div class="help-feature-check">✓</div> Mark receipts as business or personal</div>
                <div class="help-feature"><div class="help-feature-check">✓</div> Add notes and tags</div>
                <div class="help-feature"><div class="help-feature-check">✓</div> Search by merchant, category, note or tag</div>
            </div>
        </section>

        <section class="help-section" id="export">
            <div class="help-section-header">
                <div class="help-section-icon icon-green">📤</div>
                <h2>Exporting your receipts</h2>
            </div>
            <p>Get your data out whenever you like — it's yours.</p>
            <div class="help-feature-list">
                <div class="help-feature"><div class="help-feature-check">✓</div> <strong>Free:</strong> CSV export of a single receipt or the current month</div>
                <div class="help-feature"><div class="help-feature-check">✓</div> <strong>Premium:</strong> PDF export and full itemised spreadsheets (each receipt with its line items as linked rows)</div>
                <div class="help-feature"><div class="help-feature-check">✓</div> <strong>Premium:</strong> business-expense and tax summary reports</div>
            </div>
            <div class="help-tip">
                <p>💡 Exports open in Numbers, Excel, or any compatible app, and can be shared straight from the iOS share sheet.</p>
            </div>
        </section>

        <section class="help-section" id="premium">
            <div class="help-section-header">
                <div class="help-section-icon icon-pink">⭐</div>
                <h2>Premium &amp; cloud backup</h2>
            </div>
            <p>Premium unlocks item scanning, PDF &amp; itemised export, and tax reports. The <strong>monthly and annual</strong> plans additionally include <strong>Cloud Backup &amp; Sync</strong>, which keeps your receipts safe off-device and in sync across your devices.</p>
            <div class="help-tab-grid">
                <div class="help-tab-card">
                    <span class="help-tab-card-icon">🗓️</span>
                    <div><h4>Monthly / Annual</h4><p>All premium features, <strong>including cloud backup &amp; sync</strong>. £2.99/mo or £19.99/yr.</p></div>
                </div>
                <div class="help-tab-card">
                    <span class="help-tab-card-icon">♾️</span>
                    <div><h4>Lifetime</h4><p>All on-device premium features forever, one payment of £39.99. Cloud sync is on the subscriptions.</p></div>
                </div>
            </div>
            <div class="help-tip-warn">
                <p>⚠️ Subscriptions renew automatically until cancelled. You can manage or cancel anytime in your App Store account settings; deleting the app does not cancel a subscription.</p>
            </div>
            <p style="margin-top:12px;"><a href="/premium">See the full plan comparison →</a></p>
        </section>

        <section class="help-section" id="tips">
            <div class="help-section-header">
                <div class="help-section-icon icon-green">💡</div>
                <h2>Tips &amp; tricks</h2>
            </div>
            <div class="help-feature-list">
                <div class="help-feature"><div class="help-feature-check">✓</div> Scan receipts as you get them — it takes seconds and beats a shoebox at tax time</div>
                <div class="help-feature"><div class="help-feature-check">✓</div> Flag business expenses as you go so reports are one tap later</div>
                <div class="help-feature"><div class="help-feature-check">✓</div> Give scanned totals and items a quick check before saving</div>
                <div class="help-feature"><div class="help-feature-check">✓</div> On the subscription plans, turn on cloud backup so a lost phone never means lost receipts</div>
            </div>
        </section>

        <section class="help-section" id="faq">
            <div class="help-section-header">
                <div class="help-section-icon icon-purple">❓</div>
                <h2>FAQ</h2>
            </div>
            <div class="help-card">
                <h3>Do I need an account?</h3>
                <p>No. You can scan and organise receipts with no account or sign-up. A purchase is only needed for Premium.</p>
            </div>
            <div class="help-card">
                <h3>Are my receipts uploaded anywhere?</h3>
                <p>No — receipts and images stay on your device, and recognition runs on-device. Cloud backup only applies if you subscribe to a plan that includes Cloud Backup &amp; Sync.</p>
            </div>
            <div class="help-card">
                <h3>Does Lifetime include cloud sync?</h3>
                <p>No. Lifetime unlocks every on-device premium feature permanently. Cloud backup &amp; sync is an ongoing service, so it's on the monthly and annual plans.</p>
            </div>
            <div class="help-card">
                <h3>How do I get help?</h3>
                <p>Email us at <a href="mailto:farabovestudios@gmail.com">farabovestudios@gmail.com</a> — we're happy to help.</p>
            </div>
        </section>

    </div>
</div>
