@page "/"

<PageTitle>Receipt Vault — Scan, organise, never lose a receipt</PageTitle>

<HeadContent>
    <meta name="description" content="Receipt Vault scans your receipts, captures the total and every line item automatically, and keeps them organised — private and entirely on your device. No account, no cloud." />
    <link rel="canonical" href="https://receiptvault.farabove.uk/" />
    <meta property="og:title" content="Receipt Vault — Scan, organise, never lose a receipt" />
    <meta property="og:description" content="Scan receipts, auto-capture totals and line items, and keep everything organised — private on your device." />
    <meta property="og:url" content="https://receiptvault.farabove.uk/" />

    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "MobileApplication",
      "name": "Receipt Vault",
      "description": "Scan and organise receipts with automatic total and line-item capture. On-device text recognition, private by default, with premium PDF and tax & expense reports. Everything stays on your device.",
      "operatingSystem": "iOS",
      "applicationCategory": "FinanceApplication",
      "offers": [
        { "@@type": "Offer", "price": "0", "priceCurrency": "GBP", "description": "Free — unlimited receipt scanning, on-device recognition, CSV export" },
        { "@@type": "Offer", "price": "4.99", "priceCurrency": "GBP", "description": "Premium — one-time unlock: automatic item scanning, PDF & itemised export, and tax & expense reports" }
      ],
      "publisher": { "@@type": "Organization", "name": "Receipt Vault", "url": "https://receiptvault.farabove.uk" }
    }
    </script>
</HeadContent>

<!-- ═══ HERO ═══ -->
<section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-content">
        <div class="hero-badge">📸 Available on iOS</div>
        <h1>
            Scan every receipt.<br />
            <span style="color:var(--accent);">Lose nothing.</span>
        </h1>
        <p class="hero-subtitle">
            Receipt Vault reads your receipts for you — the merchant, the total, and every
            item you bought — and keeps them organised and searchable. Stored privately on
            your device, with no account and nothing uploaded to the cloud.
        </p>
        <div class="hero-actions" id="download">
            <a href="#" class="store-btn store-btn-apple">
                <span class="store-btn-icon"></span>
                <span class="store-btn-text">
                    <small>Download on the</small>
                    <span>App Store</span>
                </span>
            </a>
        </div>
    </div>
</section>

<!-- ═══ STATS ═══ -->
<div style="max-width:1200px; margin:0 auto; padding: 0 24px 0;">
    <div class="stats-row">
        <div class="stat-item">
            <div class="stat-number">100%</div>
            <div class="stat-label">On-device text recognition</div>
        </div>
        <div class="stat-item">
            <div class="stat-number">∞</div>
            <div class="stat-label">Unlimited receipts, free</div>
        </div>
        <div class="stat-item">
            <div class="stat-number">0</div>
            <div class="stat-label">Accounts or sign-ups needed</div>
        </div>
        <div class="stat-item">
            <div class="stat-number">£0</div>
            <div class="stat-label">To scan &amp; organise</div>
        </div>
    </div>
</div>

<!-- ═══ FEATURES ═══ -->
<div class="section section-center">
    <span class="section-label">Why Receipt Vault</span>
    <h2 class="section-title">Everything from the shop, captured</h2>
    <p class="section-subtitle">
        Point your camera at a receipt and Receipt Vault does the rest — no typing,
        no filing, no lost paper.
    </p>

    <div class="features-grid">
        <div class="feature-card">
            <div class="feature-icon icon-bg-purple">📸</div>
            <h3>Scan any receipt</h3>
            <p>Snap a photo and on-device text recognition reads the merchant, total and date automatically — no cloud upload to read your receipt.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon icon-bg-green">🧾</div>
            <h3>Every line item</h3>
            <p>Receipt Vault captures each item you bought, its price, and any savings — even on tricky multi-column supermarket receipts.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon icon-bg-blue">🔒</div>
            <h3>Private by default</h3>
            <p>Your receipts and images are stored on your device and never uploaded — no account, no cloud, nothing leaves your phone.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon icon-bg-orange">🏷️</div>
            <h3>Organised your way</h3>
            <p>Categories, business or personal tagging, notes and tags — then search across everything in a tap.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon icon-bg-gold">📤</div>
            <h3>Export &amp; report</h3>
            <p>Plain CSV export is free. Premium adds colour-formatted Excel spreadsheets with itemised rows, PDF export, and business-expense &amp; tax summaries.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon icon-bg-pink">🧮</div>
            <h3>Tax &amp; expense ready</h3>
            <p>Premium turns your receipts into business-expense and tax summaries — totals, VAT and a category breakdown, ready for your accountant.</p>
        </div>
    </div>
</div>

<hr class="section-divider" />

<!-- ═══ HOW IT WORKS ═══ -->
<div class="section section-center">
    <span class="section-label">Simple by design</span>
    <h2 class="section-title">Three taps to a filed receipt</h2>
    <p class="section-subtitle">No manual entry. Just point, check, and save.</p>

    <div class="features-grid" style="margin-top:0;">
        <div class="feature-card">
            <div style="font-size:2rem; font-weight:900; color:var(--primary-light); margin-bottom:16px;">01</div>
            <h3>Snap it</h3>
            <p>Take a photo of your receipt, or pick one from your photo library.</p>
        </div>
        <div class="feature-card">
            <div style="font-size:2rem; font-weight:900; color:var(--primary-light); margin-bottom:16px;">02</div>
            <h3>Check it</h3>
            <p>Receipt Vault fills in the merchant, total, date and line items. Tweak anything that needs it.</p>
        </div>
        <div class="feature-card">
            <div style="font-size:2rem; font-weight:900; color:var(--primary-light); margin-bottom:16px;">03</div>
            <h3>Save it</h3>
            <p>Categorise, tag business or personal, and it's filed — searchable and ready to export.</p>
        </div>
    </div>
</div>

<hr class="section-divider" />

<!-- ═══ PRICING ═══ -->
<div class="section section-center">
    <span class="section-label">Simple pricing</span>
    <h2 class="section-title">Free to scan. Unlock the extras once.</h2>
    <p class="section-subtitle">Scanning and organising are free forever. A single one-time purchase unlocks automatic item scanning, PDF &amp; itemised export, and tax &amp; expense reports. No subscription, no ads, ever. <a href="/premium">See the full comparison →</a></p>

    <div style="display:flex; gap:24px; justify-content:center; flex-wrap:wrap; margin-top:40px;">
        <div class="feature-card" style="flex:1; min-width:260px; max-width:340px;">
            <div style="font-size:1.1rem; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:12px;">Free</div>
            <div style="font-size:2.8rem; font-weight:900; color:var(--text); line-height:1; margin-bottom:4px;">£0</div>
            <div style="font-size:0.9rem; color:var(--text-muted); margin-bottom:20px;">Free forever — not a trial</div>
            <ul style="list-style:none; padding:0; text-align:left; font-size:0.9rem; line-height:2;">
                <li>✓ &nbsp;Unlimited receipt scanning</li>
                <li>✓ &nbsp;On-device recognition</li>
                <li>✓ &nbsp;Categories, tags &amp; search</li>
                <li>✓ &nbsp;CSV export</li>
                <li>✓ &nbsp;No account needed</li>
            </ul>
        </div>
        <div class="feature-card" style="flex:1; min-width:260px; max-width:340px; border:2px solid var(--primary); position:relative;">
            <div style="position:absolute; top:-14px; left:50%; transform:translateX(-50%); background:var(--primary); color:white; font-size:0.78rem; font-weight:700; padding:4px 14px; border-radius:20px; white-space:nowrap;">ONE-TIME PURCHASE</div>
            <div style="font-size:1.1rem; font-weight:700; color:var(--primary-light); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:12px;">Premium</div>
            <div style="font-size:2.8rem; font-weight:900; color:var(--text); line-height:1; margin-bottom:4px;">£4.99</div>
            <div style="font-size:0.9rem; color:var(--text-muted); margin-bottom:20px;">Pay once. Keep forever.</div>
            <ul style="list-style:none; padding:0; text-align:left; font-size:0.9rem; line-height:2;">
                <li>✓ &nbsp;Everything in Free</li>
                <li>✓ &nbsp;Automatic line-item scanning</li>
                <li>✓ &nbsp;<strong style="color:var(--accent);">PDF &amp; itemised export</strong></li>
                <li>✓ &nbsp;Tax &amp; expense reports</li>
                <li>✓ &nbsp;Future premium features included</li>
                <li>✓ &nbsp;No subscription. No ads. Ever.</li>
            </ul>
        </div>
    </div>

    <p style="margin-top:24px; font-size:0.85rem; color:var(--text-muted);">£4.99 is the UK price — outside the UK you pay the equivalent in your own App Store currency, shown before you buy. Everything runs on your device; no account required.</p>
</div>

<hr class="section-divider" />

<!-- ═══ CTA ═══ -->
<div class="cta-section">
    <h2>Never lose a receipt again</h2>
    <p>Download Receipt Vault free — unlimited scanning, no sign-up. Unlock item scanning, PDF export and tax reports with a single one-time purchase whenever you're ready.</p>
    <div class="cta-actions">
        <a href="#" class="store-btn store-btn-apple">
            <span class="store-btn-icon"></span>
            <span class="store-btn-text">
                <small>Download on the</small>
                <span>App Store</span>
            </span>
        </a>
    </div>
</div>
