@inject NavigationManager Nav

<nav class="navbar" role="navigation" aria-label="Main navigation">
    <a class="navbar-brand" href="/" aria-label="Receipt Vault home">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" aria-hidden="true">
            <rect width="100" height="100" rx="22" fill="#6C63FF"/>
            <radialGradient id="rgNav" cx="50%" cy="38%" r="55%">
                <stop offset="0%" stop-color="#8B84FF" stop-opacity="0.6"/>
                <stop offset="100%" stop-color="#4B44C0" stop-opacity="0"/>
            </radialGradient>
            <rect width="100" height="100" rx="22" fill="url(#rgNav)"/>
            <path d="M32 24 H68 V74 l-6 4 -6 -4 -6 4 -6 -4 -6 4 -6 -4 Z" fill="#fff"/>
            <rect x="39" y="34" width="22" height="4.5" rx="2.25" fill="#6C63FF"/>
            <rect x="39" y="44" width="22" height="4.5" rx="2.25" fill="#6C63FF"/>
            <rect x="39" y="54" width="13" height="4.5" rx="2.25" fill="#12D4A0"/>
        </svg>
        Receipt Vault
    </a>

    <div class="navbar-links" id="navbar-links" role="menubar">
        <a href="/"        class="@NavClass("/")"        role="menuitem">Home</a>
        <a href="/help"    class="@NavClass("/help")"    role="menuitem">Help</a>
        <a href="/premium" class="@NavClass("/premium")" role="menuitem">Premium</a>
        <a href="/privacy" class="@NavClass("/privacy")" role="menuitem">Privacy</a>
        <a href="#download" class="navbar-cta"           role="menuitem">Download</a>
    </div>

    <button class="nav-toggle" aria-controls="navbar-links" aria-expanded="false" aria-label="Toggle navigation">
        ☰
    </button>
</nav>

@code {
    string NavClass(string path)
    {
        var current = new Uri(Nav.Uri).AbsolutePath;
        return (path == "/" ? current == "/" : current.StartsWith(path)) ? "active" : "";
    }
}
