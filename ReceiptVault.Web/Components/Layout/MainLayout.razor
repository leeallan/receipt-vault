@inherits LayoutComponentBase
@using System.Reflection

<NavMenu />

<main>
    @Body
</main>

<footer>
    <div class="footer-top">
        <div class="footer-brand">
            <div class="navbar-brand" style="margin-bottom:8px;">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="32" height="32" aria-hidden="true">
                    <rect width="100" height="100" rx="22" fill="#6C63FF"/>
                    <radialGradient id="rgFoot" cx="50%" cy="38%" r="55%">
                        <stop offset="0%" stop-color="#8B84FF" stop-opacity="0.6"/>
                        <stop offset="100%" stop-color="#4B44C0" stop-opacity="0"/>
                    </radialGradient>
                    <rect width="100" height="100" rx="22" fill="url(#rgFoot)"/>
                    <path d="M32 24 H68 V74 l-6 4 -6 -4 -6 4 -6 -4 -6 4 -6 -4 Z" fill="#fff"/>
                    <rect x="39" y="34" width="22" height="4.5" rx="2.25" fill="#6C63FF"/>
                    <rect x="39" y="44" width="22" height="4.5" rx="2.25" fill="#6C63FF"/>
                    <rect x="39" y="54" width="13" height="4.5" rx="2.25" fill="#12D4A0"/>
                </svg>
                <span>Receipt Vault</span>
            </div>
            <p>Scan, organise, and never lose a receipt. Automatic totals and line items, all stored privately on your device.</p>
        </div>
        <div class="footer-col">
            <h4>App</h4>
            <a href="/">Home</a>
            <a href="/help">Help Guide</a>
            <a href="/premium">Premium</a>
        </div>
        <div class="footer-col">
            <h4>Support</h4>
            <a href="/help">How-to &amp; FAQ</a>
            <a href="/privacy">Privacy Policy</a>
            <a href="mailto:farabovestudios@gmail.com">Contact</a>
        </div>
        <div class="footer-col">
            <h4>Download</h4>
            <a href="#download">App Store</a>
        </div>
    </div>
    <div class="footer-bottom">
        <span>&copy; @DateTime.Now.Year Receipt Vault. All rights reserved. &nbsp;·&nbsp; <a href="/privacy" style="color:inherit;">Privacy Policy</a></span>
        <span>Made with ♥ &nbsp;·&nbsp; <span style="opacity:0.55;" title="Live build">@VersionLabel</span></span>
    </div>
</footer>

@code {
    private static readonly string VersionLabel = BuildVersionLabel();

    private static string BuildVersionLabel()
    {
        var asm = typeof(MainLayout).Assembly;

        var info = asm.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion
            ?? asm.GetName().Version?.ToString()
            ?? "1.0.0";
        var plus = info.IndexOf('+'); // strip SourceLink commit hash if present
        var version = plus >= 0 ? info[..plus] : info;

        var buildTime = asm.GetCustomAttributes<AssemblyMetadataAttribute>()
            .FirstOrDefault(a => a.Key == "BuildTime")?.Value;

        return buildTime is null ? $"v{version}" : $"v{version} · {buildTime}";
    }
}
